# Copy to .env.local and fill in. Only VITE_* values are visible to the browser,
# so NEVER put secrets (API keys, payment keys, service-role keys) in this file's VITE_ variables.

# Public contact email used by the contact form and consultation-request "Open in email app" action.
# Leave empty and the site will say online contact is not configured yet.
VITE_CONTACT_EMAIL=
